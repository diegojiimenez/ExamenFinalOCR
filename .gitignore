# ============================================
# MODELOS ENTRENADOS (No subir a GitHub)
# ============================================
models/*.h5
models/*.hdf5
models/*.pkl
models/*.pickle
models/*.joblib
models/*.pt
models/*.pth
models/*.onnx
models/*.pb
models/*.tflite

# Pero mantener la carpeta models/
!models/.gitkeep

# ============================================
# DATOS (CRÍTICO: No subir imágenes)
# ============================================
# Ignorar TODA la carpeta data/ y su contenido
data/
data/**/*

# Específicamente ignorar subcarpetas de datos
data/dataset/
data/referencia/
data/pruebas/
data/test_images/
data/raw/
data/processed/

# Ignorar todos los tipos de imágenes en cualquier lugar
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.tif
*.ico
*.svg
*.webp

# Pero permitir imágenes de documentación si las necesitas
!docs/**/*.png
!docs/**/*.jpg
!README_images/*.png

# Mantener estructura de carpetas (opcional)
!data/.gitkeep
!data/dataset/.gitkeep
!data/referencia/.gitkeep
!data/pruebas/.gitkeep

# ============================================
# OUTPUTS y LOGS
# ============================================
output/
outputs/
results/
logs/
*.log
debug_*.png
debug_*.jpg

